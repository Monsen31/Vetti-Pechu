# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Never share .env or commit it anywhere. It holds your secrets.

# From console.anthropic.com > API Keys (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# From discord.com/developers > your app > Bot > Reset Token
DISCORD_TOKEN=REPLACE_ME

# Which AI answers: claude (default) or groq (free tier)
# PROVIDER=claude
# From console.groq.com > API Keys (starts with gsk_). Only needed for groq.
# GROQ_API_KEY=gsk_REPLACE_ME
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Look at pictures people share with the bot
# IMAGES=on

# Optional settings (the defaults are fine)
# CLAUDE_MODEL=claude-haiku-5-5
# HISTORY_LIMIT=20

# Web browsing (searching the web and reading pages). Set to off to disable.
# Each web search costs $0.01; the limits below are per reply.
# WEB_BROWSING=on
# WEB_MAX_SEARCHES=3
# WEB_MAX_PAGE_READS=2

# Reply when someone pings @everyone or @here (set to off to only reply to direct mentions)
# REPLY_TO_EVERYONE=on

# Long-term memory of names and facts, saved in memory.json next to bot.py
# MEMORY=on

# BOT_NAME=Vetti Pechu
# SYSTEM_PROMPT=You are Vetti Pechu, the witty friend in our group chat. Keep it short.
